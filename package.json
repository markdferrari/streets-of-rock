{
  "name": "streets-of-rock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "bun run test:unit && bun run test:e2e",
    "build": "bun run typecheck && vite build && bun scripts/build-asset-inventory.ts",
    "build:test": "VITE_TEST_MODE=1 bun run build",
    "build:diagnostics": "VITE_DIAGNOSTICS=1 bun run build",
    "audit:build": "bun scripts/audit-build.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "0.186.0",
    "vite-plugin-pwa": "1.3.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-range-requests": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.4",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
