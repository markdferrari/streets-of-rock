{
  "name": "streets-of-rock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "godot --editor --path .",
    "typecheck": "bun run typecheck:tooling && bun run typecheck:godot",
    "test:unit": "bun run test:platform && bun run test:godot",
    "test:e2e": "bun run test:e2e:godot && bun run test:e2e:release",
    "test": "bun run test:unit && bun run test:parity && bun run test:e2e && bun run test:blender",
    "build": "bun scripts/godot/export.ts release",
    "build:test": "bun scripts/godot/export.ts test",
    "build:diagnostics": "bun scripts/godot/export.ts diagnostics",
    "audit:build": "bun scripts/audit-build.ts",
    "preview": "bun scripts/preview.ts",
    "setup:godot": "bun scripts/godot/setup.ts",
    "test:godot": "bun scripts/godot/test.ts",
    "typecheck:godot": "bun scripts/godot/typecheck.ts",
    "test:blender": "bun scripts/test-blender.ts",
    "test:platform": "vitest run tests/tooling tests/platform",
    "test:e2e:godot": "playwright test --config playwright.godot.config.ts",
    "test:foundation": "bun run test:platform && bun run test:godot && bun run test:e2e:godot && bun run test:e2e:release",
    "test:e2e:release": "playwright test --config playwright.release.config.ts",
    "test:parity": "bun scripts/godot/parity.ts",
    "typecheck:tooling": "tsc --noEmit"
  },
  "dependencies": {
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.4",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "workbox-build": "7.4.1"
  },
  "godotTooling": {
    "editor": "4.7.2",
    "gut": "9.7.1"
  }
}
