{
  "name": "streets-of-rock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "godot --editor --path .",
    "typecheck": "bun run typecheck:legacy && bun run typecheck:godot",
    "test:unit": "bun run test:legacy:unit && bun run test:platform && bun run test:godot",
    "test:e2e": "bun run test:e2e:legacy && bun run test:e2e:godot && bun run test:e2e:release",
    "test": "bun run test:unit && bun run test:parity && bun run test:e2e && bun run test:blender",
    "build": "bun scripts/godot/export.ts release",
    "build:test": "bun scripts/godot/export.ts test",
    "build:diagnostics": "bun scripts/godot/export.ts diagnostics",
    "audit:build": "bun scripts/audit-build.ts",
    "preview": "bun scripts/preview.ts",
    "setup:godot": "bun scripts/godot/setup.ts",
    "test:godot": "bun scripts/godot/test.ts",
    "typecheck:godot": "bun scripts/godot/typecheck.ts",
    "test:blender": "bun scripts/test-blender.ts",
    "test:platform": "vitest run tests/tooling tests/platform",
    "dev:legacy": "vite --host",
    "typecheck:legacy": "tsc --noEmit",
    "test:legacy:unit": "vitest run tests/unit tests/integration",
    "test:e2e:legacy": "playwright test",
    "test:e2e:godot": "playwright test --config playwright.godot.config.ts",
    "build:legacy": "bun run typecheck:legacy && vite build --outDir dist-legacy && bun scripts/build-asset-inventory.ts dist-legacy",
    "build:legacy:test": "VITE_TEST_MODE=1 bun run build:legacy",
    "build:legacy:diagnostics": "VITE_DIAGNOSTICS=1 bun run build:legacy",
    "preview:legacy": "vite preview --outDir dist-legacy",
    "reference:capture": "bun scripts/reference/capture.ts",
    "test:foundation": "bun run test:platform && bun run test:godot && bun run test:e2e:godot && bun run test:e2e:release",
    "test:e2e:release": "playwright test --config playwright.release.config.ts",
    "test:parity": "bun scripts/godot/parity.ts"
  },
  "dependencies": {
    "three": "0.186.0",
    "vite-plugin-pwa": "1.3.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-range-requests": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.4",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "workbox-build": "7.4.1"
  },
  "godotTooling": {
    "editor": "4.7.2",
    "gut": "9.7.1"
  }
}
