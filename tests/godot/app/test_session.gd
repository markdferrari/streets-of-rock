extends GutTest
const Selection = preload("res://game/app/selection.gd")
const Session = preload("res://game/app/run_session.gd")
const State = preload("res://game/simulation/run_state.gd")
const Catalogue = preload("res://game/content/catalogue.gd")
const Tutorial = preload("res://game/ui/tutorial.gd")
var content: RefCounted
func before_each() -> void:
 content = Catalogue.new()
 assert_true(content.load_catalogue())
func choose(session: RefCounted) -> void:
 for id in ["cow", "cow", "crow", "crow"]: session.select({"type": "activate", "id": id, "ready": true})
func test_two_step_selection_focus_no_preview_duplicate_and_back() -> void:
 var initial := Selection.initial(content.roster)
 var focused: Dictionary = Selection.reduce(initial, {"type": "focus", "id": "lion"}, content.roster).state
 assert_null(focused.previewedId)
 var preview: Dictionary = Selection.reduce(focused, {"type": "activate", "id": "lion", "ready": false}, content.roster).state
 assert_eq(preview.previewedId, "lion")
 assert_eq(Selection.reduce(preview, {"type": "activate", "id": "lion", "ready": false}, content.roster).state.step, "fighter")
 var partner: Dictionary = Selection.reduce(preview, {"type": "activate", "id": "lion", "ready": true}, content.roster).state
 assert_eq(partner.step, "partner")
 assert_eq(Selection.reduce(partner, {"type": "activate", "id": "lion", "ready": true}, content.roster).state, partner)
 assert_eq(Selection.reduce(partner, {"type": "back"}, content.roster).state.step, "fighter")
func test_generation_safe_readiness_interrupt_partial_countdown_retry_and_home() -> void:
 var session := Session.new(content)
 choose(session)
 assert_eq(session.phase, "preparing")
 assert_eq(session.generation, 1)
 var run := State.create_run(1, {"fighterId": "cow", "partnerId": "crow"}, content)
 assert_false(session.prepared(0, run, 0))
 assert_true(session.prepared(1, run, 0))
 assert_eq(session.phase, "countdown")
 session.frame(750)
 session.interrupt(750)
 session.frame(9999)
 assert_eq(session.phase, "paused")
 session.resume(false, 9999)
 assert_eq(session.phase, "paused")
 session.resume(true, 10000)
 session.frame(10250)
 if session.countdown != null: assert_eq(session.countdown.number, 2)
 session.frame(11250)
 session.frame(12250)
 assert_eq(session.phase, "running")
 run.actors[0].hp = 0
 session.finish()
 assert_eq(session.phase, "defeat")
 session.retry()
 assert_eq(session.phase, "preparing")
 assert_eq(session.duo, {"fighterId": "cow", "partnerId": "crow"})
 assert_true(session.run.is_empty())
 session.failed(1, "late failure")
 assert_eq(session.phase, "preparing")
 session.failed(2, "Missing required model: retry")
 assert_eq(session.phase, "error")
 session.home()
 assert_eq(session.phase, "selecting")
 assert_true(session.duo.is_empty())
 assert_false(session.prepared(2, run, 14000))
func test_legacy_attack_does_not_complete_heavy_and_dodge_is_contextual() -> void:
 var tutorial := Tutorial.new(["movement", "attack"])
 var run := State.create_run(1, {"fighterId": "cow", "partnerId": "crow"}, content)
 assert_eq(tutorial.suggest(run), "heavy")
 tutorial.accept([{"type": "heavy", "tick": 1}], false)
 assert_null(tutorial.suggest(run))
 tutorial.accept([{"type": "enemy-warning", "tick": 2}], false)
 assert_eq(tutorial.suggest(run), "dodge")
func test_interruption_on_final_countdown_boundary_launches_once_only_after_safe_resume() -> void:
 var session := Session.new(content)
 choose(session)
 var run := State.create_run(1, {"fighterId": "cow", "partnerId": "crow"}, content)
 assert_true(session.prepared(1, run, 0))
 session.frame(1000)
 session.frame(2000)
 assert_eq(session.countdown.number, 1)
 session.interrupt(3001) # pause samples the final elapsed second before _process does.
 assert_eq(session.phase, "paused")
 assert_true(session.countdown.completed)
 assert_eq(session.frame(10000), [], "completion cannot launch while interrupted")
 assert_eq(session.resume(false, 10000), [])
 assert_eq(session.phase, "paused")
 session.resume(true, 11000)
 var events: Array = session.frame(11001)
 assert_eq(session.phase, "running", "completed countdown must not get stuck after explicit Resume")
 assert_eq(events.filter(func(event: Dictionary) -> bool: return event.type == "launch").size(), 1)
 assert_eq(session.frame(11002), [], "launch is emitted exactly once")
