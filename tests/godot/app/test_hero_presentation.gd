extends GutTest
const Catalogue = preload("res://game/content/catalogue.gd")
const Session = preload("res://game/app/run_session.gd")
const State = preload("res://game/simulation/run_state.gd")
const Motion = preload("res://game/presentation/character_motion_state.gd")
const Preview = preload("res://game/presentation/hero_clock.gd")
func test_terminal_resume_restores_results_without_advancing_run_and_retry_is_immediate() -> void:
 var c := Catalogue.new()
 assert_true(c.load_catalogue())
 var s := Session.new(c)
 for id in ["cow","cow","crow","crow"]: s.select({"type":"activate","id":id,"ready":true})
 var run := State.create_run(1, s.duo, c)
 s.prepared(1, run, 0)
 s.phase = "running"
 run.actors[0].hp = 0
 s.finish()
 var before := run.duplicate(true)
 s.interrupt(10)
 assert_eq(s.phase, "paused")
 assert_eq(s.resume_target, "defeat")
 s.resume(false, 1000)
 assert_eq(s.phase, "paused")
 s.resume(true, 1100)
 assert_eq(s.phase, "defeat")
 assert_eq(run, before)
 assert_false(s.retry().is_empty())
 assert_eq(s.phase, "preparing")
 assert_eq(s.duo, {"fighterId":"cow","partnerId":"crow"})
func test_independent_preview_clocks_freeze_and_reduced_motion_is_fixed() -> void:
 var a := Preview.new()
 var b := Preview.new()
 assert_eq(a.advance(0.2, true, false), 0.2)
 assert_eq(b.elapsed, 0.0)
 assert_eq(a.advance(0.2, false, false), 0.2)
 assert_eq(a.advance(0.2, true, true), 0.0)
 assert_eq(a.elapsed, 0.2)
func test_terminal_settle_is_bounded_and_does_not_touch_actor() -> void:
 var m := Motion.new()
 var actor := {"id":1,"hp":0,"position":{"x":0,"depth":0},"action":{"kind":"idle","startedTick":0,"endTick":0}}
 m.observe(actor, 9, [])
 var before := actor.duplicate(true)
 m.settle(0.1, 0.6)
 assert_almost_eq(m.knockout_elapsed, 0.1, 0.00001)
 m.settle(0, 0.6)
 assert_almost_eq(m.knockout_elapsed, 0.1, 0.00001)
 m.settle(100, 0.6)
 assert_almost_eq(m.knockout_elapsed, 0.6, 0.00001)
 assert_eq(actor, before)

func test_stale_preparation_cannot_replace_new_duo_or_its_error() -> void:
 var c := Catalogue.new()
 assert_true(c.load_catalogue())
 var s := Session.new(c)
 for id in ["cow","cow","crow","crow"]: s.select({"type":"activate","id":id,"ready":true})
 var old_run := State.create_run(1,s.duo,c)
 s.failed(1,"cow: missing physical clip; repair and Retry")
 s.retry()
 assert_false(s.prepared(1,old_run,0))
 s.failed(1,"late error")
 assert_eq(s.phase,"preparing")
 assert_true(s.prepared(2,State.create_run(2,s.duo,c),0))
 assert_eq(s.run.runId,2)
