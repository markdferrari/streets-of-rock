extends GutTest
const Store = preload("res://game/content/resource_store.gd")
const Catalogue = preload("res://game/content/catalogue.gd")
const Fixtures = preload("res://tests/godot/content/test_hero_animation_catalog.gd")
func test_profile_readiness_checks_physical_segments_on_every_cached_prepare() -> void:
 var c := Catalogue.new()
 assert_true(c.load_catalogue())
 var store := Store.new()
 assert_true(store.prepare_hero(c,"cow"),str(store.errors))
 var profile: Dictionary = c.hero_profiles.cow.duplicate(true)
 profile.bindings.Idle.endSeconds = 999
 assert_false(store.prepare_profile("cow","res://"+c.resources.models.cow,profile))
 assert_string_contains(str(store.errors),"Idle")
 assert_null(store.create("cow"),"invalid cached profile cannot leave a usable stale template")
 assert_true(store.prepare_hero(c,"cow"))
 profile = c.hero_profiles.cow.duplicate(true)
 profile.bindings.Idle.clipName = "Missing"
 assert_false(store.prepare_profile("cow","res://"+c.resources.models.cow,profile))
 assert_string_contains(str(store.errors),"Missing")
func test_missing_profile_scene_and_invalid_bone_mask_fail_actionably() -> void:
 var c := Catalogue.new()
 assert_true(c.load_catalogue())
 var store := Store.new()
 assert_false(store.prepare_profile("cow","res://missing.glb",{}))
 assert_false(store.prepare_profile("cow","res://"+c.resources.models.cow,{}))
 var profile: Dictionary = c.hero_profiles.cow.duplicate(true)
 profile.reactionBoneNames = ["NotABone"]
 assert_false(store.prepare_profile("cow","res://"+c.resources.models.cow,profile))
 assert_string_contains(str(store.errors),"NotABone")

func test_cached_template_cannot_hide_invalid_node_tracks() -> void:
 var c := Catalogue.new()
 assert_true(c.load_catalogue())
 var store := Store.new()
 assert_true(store.prepare_hero(c,"cow"))
 var probe: Node3D = store.templates.cow.instantiate()
 var player := Store.find_animation(probe)
 var library: AnimationLibrary = player.get_animation_library("").duplicate(true)
 player.remove_animation_library("")
 player.add_animation_library("",library)
 var animation: Animation = player.get_animation("Idle")
 var track := animation.add_track(Animation.TYPE_METHOD)
 animation.track_set_path(track,NodePath("."))
 animation.track_insert_key(track,0,{"method":"queue_free","args":[]})
 var scene := PackedScene.new()
 assert_eq(scene.pack(probe),OK)
 probe.free()
 store.templates.cow = scene
 assert_false(store.prepare_hero(c,"cow"))
 assert_string_contains(str(store.errors),"unsupported")
 assert_false(store.templates.has("cow"))

func test_imported_nonfinite_track_keys_and_root_motion_are_rejected() -> void:
 var c := Catalogue.new()
 assert_true(c.load_catalogue())
 for corruption in ["nonfinite", "root"]:
  var store := Store.new()
  assert_true(store.prepare_hero(c,"cow"))
  var probe: Node3D = store.templates.cow.instantiate()
  var player := Store.find_animation(probe)
  var library: AnimationLibrary = player.get_animation_library("").duplicate(true)
  player.remove_animation_library("")
  player.add_animation_library("",library)
  var animation: Animation = player.get_animation("Idle")
  var skeleton: Skeleton3D = probe.find_children("*","Skeleton3D",true,false)[0]
  var root := player.get_node(player.root_node)
  var track := animation.add_track(Animation.TYPE_POSITION_3D)
  animation.track_set_path(track,NodePath(str(root.get_path_to(skeleton))+":Root"))
  animation.position_track_insert_key(track,0,Vector3.ZERO)
  animation.position_track_insert_key(track,0.5,Vector3(NAN,0,0) if corruption=="nonfinite" else Vector3.ONE)
  var inspected: Array = load("res://game/content/hero_animation_catalog.gd").inspect(probe,c.hero_profiles.cow)
  assert_false(inspected.is_empty(),corruption)
  if corruption=="nonfinite": assert_string_contains(str(inspected),"nonfinite")
  probe.free()
